# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secreto usado para firmar la cookie que certifica que el PIN fue verificado
# en la sesion actual. Genera uno con: openssl rand -base64 32
PIN_COOKIE_SECRET=changeme

# URL publica del sitio (usada en los enlaces de recuperacion de contrasena).
# Opcional en desarrollo (por defecto http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
